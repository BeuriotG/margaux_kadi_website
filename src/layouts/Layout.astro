---
import "../styles/global.css";
import facebook from "../assets/icons/Facebook_Logo_Primary.png";
import instagram from "../assets/icons/Instagram_Glyph_Gradient.png";
import { Image } from "astro:assets";
import NavLinks from "../components/NavLinks.astro";
import BurgerMenu from "../components/BurgerMenu.astro";
import logo from "../assets/icons/Site Web Logo.png";

const navLinks = [
    { title: "Qui je suis", link: "#qui_je_suis" },
    { title: "Les cours de chant", link: "#les_cours_de_chant" },
    { title: "La TCM", link: "#tcm" },
    { title: "Contact", link: "#contact" },
];
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Coach vocale et professeure de technique vocale. Site professionnel de Margaux Kadi."
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Quicksand:wght@300..700&display=swap"
            rel="stylesheet"
        />
        <link rel="canonical" href="https://margauxkadi.com/" />
        <meta name="generator" content={Astro.generator} />
        <meta
            property="og:title"
            content="Site officiel de Margaux Kadi, professeure de technique vocale."
        />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Margaux Kadi" />
        <meta property="og:locale" content="fr_FR" />
        <meta
            property="og:description"
            content="Coach vocale et professeure de technique vocale. Site professionnel de Margaux Kadi. Elle permet aux professionnels de la voix de s'améliorer et maîtriser au mieux leur appareil de travail."
        />
        <title>
            Margaux Kadi - Coach Vocale & Professeure de Technique Vocale
        </title>
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Margaux Kadi",
                givenName: "Margaux",
                familyName: "Kadi",
                jobTitle: "Coach vocale et professeure de technique vocale",
                image: "/images/Margaux_Kadi_portrait.jpg",
                sameAs: ["https://www.instagram.com/margauxkadilaurenson/"],
                email: "margaux.kadi@gmail.com",
                makesOffer: [
                    {
                        "@type": "Offer",
                        itemOffered: {
                            "@type": "Service",
                            name: "Cours particuliers de chant",
                            description:
                                "Cours individuels de technique vocale",
                        },
                    },
                    {
                        "@type": "Offer",
                        itemOffered: {
                            "@type": "Service",
                            name: "Cours collectifs de chant",
                        },
                    },
                    {
                        "@type": "Offer",
                        itemOffered: {
                            "@type": "Service",
                            name: "Ateliers vocaux",
                        },
                    },
                ],
            })}
        />
    </head>
    <header
        class="flex justify-center md:justify-evenly items-center md:h-1/5 w-4/5 m-auto"
    >
        <Image
            src={logo}
            alt="Logo signature Margaux Kadi"
            class="shrink-0 md:h-auto w-full min-w-28 max-w-52 md:max-w-64"
        />
        <!-- Desktop nav (masqué sur mobile) -->
        <nav class="hidden md:flex justify-evenly w-4/5 m-3 p-2">
            {
                navLinks.map((link) => (
                    <NavLinks title={link.title} link={link.link} />
                ))
            }
        </nav>
        <div class="flex shrink-0 justify-center items-start gap-3 md:me-5">
            <a
                href="https://www.instagram.com/margauxkadilaurenson/?hl=fr"
                target="_blank"
                ><Image
                    src={instagram}
                    width={60}
                    height={60}
                    alt="logo instagram"
                /></a
            >
            <a
                href="https://www.facebook.com/margaux.kadi.laurenson"
                target="_blank"
                class="hidden md:inline"
                ><Image
                    src={facebook}
                    width={60}
                    height={60}
                    alt="logo facebook"
                /></a
            >
        </div>
        <!-- Burger menu (visible uniquement sur mobile, placé à droite des icônes sociales) -->
        <BurgerMenu links={navLinks} />
    </header>
    <body>
        <slot />
    </body>

    <style>
        html {
            scroll-behavior: smooth;
        }
        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
        }
    </style>


</html>
